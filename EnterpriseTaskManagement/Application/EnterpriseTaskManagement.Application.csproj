<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EnterpriseTaskManagement.Application</RootNamespace>
    <AssemblyName>EnterpriseTaskManagement.Application</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Use-case layer: CQRS (MediatR) + input validation (FluentValidation) + DI
    abstractions only. It must NEVER reference EF Core, ASP.NET Core or any
    database provider: persistence is reached exclusively through abstractions
    declared here (IUserRepository, IUnitOfWork).
  -->
  <ItemGroup>
    <PackageReference Include="MediatR" Version="13.0.0" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\EnterpriseTaskManagement.Domain.csproj" />
  </ItemGroup>

</Project>
