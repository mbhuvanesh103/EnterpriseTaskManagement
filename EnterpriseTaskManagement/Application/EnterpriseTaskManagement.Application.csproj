<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EnterpriseTaskManagement.Application</RootNamespace>
    <AssemblyName>EnterpriseTaskManagement.Application</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Application depends on Domain only. It must NEVER reference EF Core,
    ASP.NET Core or any database provider: persistence is reached exclusively
    through abstractions declared here (e.g. IUserRepository, IUnitOfWork).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Domain\EnterpriseTaskManagement.Domain.csproj" />
  </ItemGroup>

</Project>
