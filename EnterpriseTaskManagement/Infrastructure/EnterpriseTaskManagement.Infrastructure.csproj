<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EnterpriseTaskManagement.Infrastructure</RootNamespace>
    <AssemblyName>EnterpriseTaskManagement.Infrastructure</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NU1903: Microsoft.Data.SqlClient (pulled in by the EF Core 10 SQL Server
      provider) still declares System.Security.Cryptography.Xml 9.0.0. The
      package is superseded at runtime by the net10.0 framework assembly and no
      newer standalone version is published, so the advisory cannot be resolved
      by a version bump. Revisit when SqlClient updates the dependency.
    -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- EF Core 10 + SQL Server provider. No other database technology is used. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <!-- JWT signing/serialization only. Token *validation* lives in the API. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0" />
  </ItemGroup>

  <!-- Dependency direction: Domain <- Application <- Infrastructure. -->
  <ItemGroup>
    <ProjectReference Include="..\Application\EnterpriseTaskManagement.Application.csproj" />
    <ProjectReference Include="..\Domain\EnterpriseTaskManagement.Domain.csproj" />
  </ItemGroup>

</Project>
